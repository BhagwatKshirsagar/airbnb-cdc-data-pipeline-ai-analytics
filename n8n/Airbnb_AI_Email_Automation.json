    {
      "parameters": {
        "promptType": "define",
        "text": "=Return ONLY a valid JSON object with keys \"email\", \"subject\", and \"body\". Do not include any explanation, markdown, or extra text.\n\nWrite a short, warm email for {{ $json.customer_name }} (patil@gmail.com) about their Airbnb booking.\n\nData:\n- Status: {{ $json.status }}\n- Amount: {{ $json.total_amount }}\n- Booking date: {{ $json.booking_date }}\n- City: {{ $json.city }}\n- Country: {{ $json.country_code }}\n\nRules:\n- If status == \"Confirmed\", congratulate and mention booking_date and city.\n- If status == \"Cancelled\", be empathetic and offer help to rebook.\n- Keep it 90 to 140 words. Use Indian English.\n- Write engaging & customized email for each customer, don't use same template",
        "hasOutputParser": true,
        "batching": {}
